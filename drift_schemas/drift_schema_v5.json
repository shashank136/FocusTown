  "fixed_sql": [
    {
      "name": "towns",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"towns\" (\"id\" INTEGER NOT NULL, \"worker_count\" INTEGER NOT NULL, \"plots_unlocked\" INTEGER NOT NULL, \"xp\" INTEGER NOT NULL, \"streak_count\" INTEGER NOT NULL, \"last_streak_date\" TEXT NULL, \"last_plot_grant_date\" TEXT NULL, \"in_recovery_mode\" INTEGER NOT NULL CHECK (\"in_recovery_mode\" IN (0, 1)), \"onboarding_done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"onboarding_done\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"last_duration_minutes\" INTEGER NOT NULL DEFAULT 25, \"tip_pass_shown\" INTEGER NOT NULL DEFAULT 0 CHECK (\"tip_pass_shown\" IN (0, 1)), \"tip_growth_shown\" INTEGER NOT NULL DEFAULT 0 CHECK (\"tip_growth_shown\" IN (0, 1)), \"tip_recovery_shown\" INTEGER NOT NULL DEFAULT 0 CHECK (\"tip_recovery_shown\" IN (0, 1)), \"notification_note_shown\" INTEGER NOT NULL DEFAULT 0 CHECK (\"notification_note_shown\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "buildings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"buildings\" (\"id\" TEXT NOT NULL, \"tier\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"plot_index\" INTEGER NULL, \"session_id\" TEXT NULL, \"completed_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" TEXT NOT NULL, \"planned_minutes\" INTEGER NOT NULL, \"tier\" TEXT NOT NULL, \"workers_assigned\" INTEGER NOT NULL, \"state\" TEXT NOT NULL, \"started_at_wall\" INTEGER NOT NULL, \"started_at_uptime_ms\" INTEGER NOT NULL, \"left_at_wall\" INTEGER NULL, \"left_at_uptime_ms\" INTEGER NULL, \"away_total_ms\" INTEGER NOT NULL, \"pass_used\" INTEGER NOT NULL CHECK (\"pass_used\" IN (0, 1)), \"outcome_reason\" TEXT NULL, \"resolved_at\" INTEGER NULL, \"plot_index\" INTEGER NULL, \"repair_plot_index\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
  ]
